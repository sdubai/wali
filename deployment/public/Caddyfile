walle.kangqing.net {
	encode zstd gzip

	@xiaozhi_ws path /xiaozhi/v1/
	reverse_proxy @xiaozhi_ws xiaozhi-server:8000

	@xiaozhi_ota path /xiaozhi/ota/*
	reverse_proxy @xiaozhi_ota xiaozhi-web:8002

	@xiaozhi_mcp path /mcp/*
	reverse_proxy @xiaozhi_mcp xiaozhi-server:8003

	@mqtt path /mqtt
	reverse_proxy @mqtt emqx:8083

	root * /srv/walle-web
	try_files {path} /index.html
	file_server

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
}

admin-walle.kangqing.net {
	encode zstd gzip
	reverse_proxy xiaozhi-web:8002
}
