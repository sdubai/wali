walle.kangqing.net {
	encode zstd gzip

	handle /xiaozhi/v1/* {
		reverse_proxy xiaozhi-server:8000
	}

	handle /xiaozhi/ota/* {
		reverse_proxy xiaozhi-web:8002
	}

	handle /mcp/* {
		reverse_proxy xiaozhi-server:8003
	}

	handle /mqtt {
		reverse_proxy emqx:8083
	}

	handle {
		root * /srv/walle-web
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
}

admin-walle.kangqing.net {
	encode zstd gzip
	reverse_proxy xiaozhi-web:8002
}
