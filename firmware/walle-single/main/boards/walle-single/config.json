{
  "type": "walle-single",
  "target": "esp32s3",
  "builds": [
    {
      "name": "walle-single-16m",
      "sdkconfig_append": [
        "CONFIG_BOARD_TYPE_WALLE_SINGLE=y",
        "CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y",
        "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v1/16m.csv\"",
        "CONFIG_OTA_URL=\"https://walle.kangqing.net/xiaozhi/ota/\"",
        "CONFIG_WAKE_WORD_DISABLED=y",
        "CONFIG_USE_AFE_WAKE_WORD=n",
        "CONFIG_USE_ESP_WAKE_WORD=n",
        "CONFIG_USE_CUSTOM_WAKE_WORD=n",
        "CONFIG_USE_DEVICE_AEC=n",
        "CONFIG_USE_SERVER_AEC=n",
        "CONFIG_SR_MN_CN_NONE=y",
        "CONFIG_USE_AUDIO_PROCESSOR=y"
      ]
    }
  ]
}