{
  "type": "walle-single",
  "target": "esp32s3",
  "builds": [
    {
      "name": "walle-single-16m",
      "sdkconfig_append": [
        "CONFIG_BOARD_TYPE_WALLE_SINGLE=y",
        "CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y",
        "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v1/16m.csv\"",
        "CONFIG_OTA_URL=\"https://walle.kangqing.net/xiaozhi/ota/\"",
        "CONFIG_WAKE_WORD_DISABLED=y",
        "CONFIG_USE_AFE_WAKE_WORD=n",
        "CONFIG_USE_ESP_WAKE_WORD=n",
        "CONFIG_USE_CUSTOM_WAKE_WORD=n",
        "CONFIG_USE_DEVICE_AEC=n",
        "CONFIG_USE_SERVER_AEC=n",
        "CONFIG_SR_MN_CN_NONE=y",
        "CONFIG_USE_AUDIO_PROCESSOR=y",
        "CONFIG_BT_ENABLED=y",
        "CONFIG_BT_BLUEDROID_ENABLED=n",
        "CONFIG_BT_NIMBLE_ENABLED=y",
        "CONFIG_BT_NIMBLE_ROLE_CENTRAL=y",
        "CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n",
        "CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n",
        "CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1",
        "CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y",
        "CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y",
        "CONFIG_WALLE_BLE_GAMEPAD=y",
        "CONFIG_WALLE_BLE_GAMEPAD_MAC=\"03:26:07:03:CA:12\""
      ]
    }
  ]
}
